{
  "openapi": "3.0.3",
  "info": {
    "title": "纳米足球公开数据",
    "version": "1.2.0",
    "description": "只读 JSON，无密钥。每场含开赛时间、让球、胜平负SP、让球SP。SP 为 null 表示未开售。完整 now.json：直播+竞彩74+北单398。"
  },
  "servers": [
    {
      "url": "https://raw.githubusercontent.com/2038153110-png/nami-football-feed/main"
    }
  ],
  "paths": {
    "/now.json": {
      "get": {
        "operationId": "getNow",
        "summary": "直播、竞彩74、北单398",
        "responses": {
          "200": {
            "description": "JSON feed"
          }
        }
      }
    },
    "/today.json": {
      "get": {
        "operationId": "getToday",
        "summary": "同 now.json",
        "responses": {
          "200": {
            "description": "JSON feed"
          }
        }
      }
    },
    "/jingcai.json": {
      "get": {
        "operationId": "getJingcai",
        "summary": "竞彩足球 74 场",
        "responses": {
          "200": {
            "description": "jingcai"
          }
        }
      }
    },
    "/beidan.json": {
      "get": {
        "operationId": "getBeidan",
        "summary": "北单 398 场",
        "responses": {
          "200": {
            "description": "beidan"
          }
        }
      }
    },
    "/feed.txt": {
      "get": {
        "operationId": "getFeedText",
        "summary": "纯文本",
        "responses": {
          "200": {
            "description": "text"
          }
        }
      }
    }
  }
}
