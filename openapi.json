{
  "openapi": "3.0.3",
  "info": {
    "title": "纳米足球公开数据",
    "version": "1.0.0",
    "description": "只读 JSON，无密钥，无登录。直接 GET feed.json。密钥不在本文件里。"
  },
  "servers": [
    {
      "url": "https://raw.githubusercontent.com/2038153110-png/nami-football-feed/main"
    }
  ],
  "paths": {
    "/feed.json": {
      "get": {
        "operationId": "getFeed",
        "summary": "直播、今晚竞彩、指数",
        "responses": {
          "200": {
            "description": "JSON feed"
          }
        }
      }
    },
    "/feed.txt": {
      "get": {
        "operationId": "getFeedText",
        "summary": "纯文本赛况",
        "responses": {
          "200": {
            "description": "plain text"
          }
        }
      }
    }
  }
}
